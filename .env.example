# Copy to .env (gitignored) and fill in. Use with: uv run --env-file .env python -m ...
# In GitHub Actions the same two values are repository secrets (gh secret set NAME).

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your chat id: send the bot a message, then run
#   uv run --env-file .env python -m scanner.notify --chat-id
TELEGRAM_CHAT_ID=
